# Copy to .env and adjust. .env is git-ignored; keep secrets (e.g. credentials in MONGO_URI) only there.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=climate_hazards
ALLOW_MONGOMOCK_FALLBACK=false
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_ANALYZE=15/minute
CACHE_TTL_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=/app/logs
# Log files older than this many days are deleted automatically (minimum 1).
LOG_RETENTION_DAYS=3
# The live log file is rotated early if it exceeds this size (MB).
LOG_MAX_MB=50
