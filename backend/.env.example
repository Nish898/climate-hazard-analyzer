MONGO_URI=mongodb://localhost:27017
MONGO_DB=climate_hazards
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_ANALYZE=15/minute
CACHE_TTL_DAYS=30
# Set to false in production so a missing DB fails loudly instead of using memory
ALLOW_MONGOMOCK_FALLBACK=true

# Logging (local runs write to ./logs)
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
# Log files older than this many days are deleted automatically (minimum 1).
LOG_RETENTION_DAYS=3
# The live log file is rotated early if it exceeds this size (MB).
LOG_MAX_MB=50
